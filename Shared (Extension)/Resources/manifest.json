{
  "manifest_version": 3,
  "name": "CmdSwipe",
  "version": "1.1",
  "description": "Switch Safari tabs with a configurable modifier + 2-finger horizontal swipe.",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open CmdSwipe Popup"
  }
}
